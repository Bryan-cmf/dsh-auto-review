{
  "name": "dsh-auto-review",
  "version": "1.6.0",
  "description": "DSH auto-review plugin: multi-model rotating (default GLM 5.3) four-dimension review (code/security/flow/design) → suggestions auto-injected into the project chat → agent fixes → re-review until acceptance passes / DSH 自動審查閉環插件：多模型輪換四維審查，建議注入會話聊天框，修復後自動複審直到驗收",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "code-review",
    "auto-review",
    "cordis-plugin"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ]
}
